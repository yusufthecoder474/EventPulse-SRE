# Run python scripts/bootstrap.py to generate .env with local random credentials.
POSTGRES_PASSWORD=
GRAFANA_PASSWORD=
FAULT_TOKEN=
ENABLE_FAULTS=false
APP_ENV=local
OBSERVATION_WINDOW_SECONDS=60
# Native API default is SQLite; Compose always uses PostgreSQL.
# DATABASE_URL=postgresql+psycopg://eventpulse:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/eventpulse

# Disabled OS-signal crash hook; opt in only for isolated local/CI recovery testing.
ENABLE_PROCESS_CRASH_TEST=false
